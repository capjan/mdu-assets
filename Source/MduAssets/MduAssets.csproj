<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AssemblyName>mdu-assets</AssemblyName>
    <RootNamespace>MduAssets</RootNamespace>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MduAssets.Storage\MduAssets.Storage.csproj" />
    <ProjectReference Include="..\MduAssets.Imaging\MduAssets.Imaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MduAssets.Test" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Ui\**\*" LogicalName="Ui/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
